<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "CASSIO" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
    <meta name="theme-color" content="#ff2d7a">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="CASSIO">
    <meta name="application-name" content="CASSIO">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icons/icon-192.png" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
    <style>
      html, body.cassio-body {
        margin: 0;
        background: #050505;
        color: #eee;
        min-height: 100%;
        min-height: 100dvh;
      }
      #cassio-preload {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: #050505;
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        letter-spacing: 0.12em;
        -webkit-user-select: none;
        user-select: none;
        touch-action: manipulation;
      }
      #cassio-preload .cassio-preload-title {
        font-size: clamp(1.6rem, 8vw, 2.4rem);
        font-weight: 800;
        letter-spacing: 0.14em;
      }
      #cassio-preload .cassio-preload-sub {
        margin-top: 0.45rem;
        color: #ff2e7e;
        font-size: clamp(0.65rem, 2.4vw, 0.85rem);
        font-weight: 700;
        letter-spacing: 0.16em;
      }
      #cassio-preload .cassio-preload-bar {
        display: flex;
        gap: 0.28rem;
        margin: 1.15rem 0 0.65rem;
      }
      #cassio-preload .cassio-preload-block {
        width: 0.55rem;
        height: 0.55rem;
        background: #2a2a2a;
        animation: cassio-preload-pulse 0.9s ease-in-out infinite;
      }
      #cassio-preload .cassio-preload-block:nth-child(1) { animation-delay: 0s; }
      #cassio-preload .cassio-preload-block:nth-child(2) { animation-delay: 0.06s; }
      #cassio-preload .cassio-preload-block:nth-child(3) { animation-delay: 0.12s; }
      #cassio-preload .cassio-preload-block:nth-child(4) { animation-delay: 0.18s; }
      #cassio-preload .cassio-preload-block:nth-child(5) { animation-delay: 0.24s; }
      #cassio-preload .cassio-preload-block:nth-child(6) { animation-delay: 0.3s; }
      #cassio-preload .cassio-preload-block:nth-child(7) { animation-delay: 0.36s; }
      #cassio-preload .cassio-preload-block:nth-child(8) { animation-delay: 0.42s; }
      #cassio-preload .cassio-preload-block:nth-child(9) { animation-delay: 0.48s; }
      #cassio-preload .cassio-preload-block:nth-child(10) { animation-delay: 0.54s; }
      #cassio-preload .cassio-preload-block:nth-child(11) { animation-delay: 0.6s; }
      #cassio-preload .cassio-preload-block:nth-child(12) { animation-delay: 0.66s; }
      #cassio-preload .cassio-preload-msg {
        color: #8a8a8a;
        font-family: ui-monospace, "Cascadia Code", "SF Mono", Menlo, monospace;
        font-size: clamp(0.6rem, 2vw, 0.75rem);
        letter-spacing: 0.08em;
      }
      @keyframes cassio-preload-pulse {
        0%, 100% { background: #2a2a2a; }
        40% { background: #39ff14; }
      }
    </style>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "cassio_manual", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600;700&family=Syne:wght@700;800&display=swap" rel="stylesheet">
  </head>
  <body class="cassio-body">
    <div id="cassio-preload" role="status" aria-live="polite" aria-label="CASSIO loading">
      <div class="cassio-preload-title">CASSIO</div>
      <div class="cassio-preload-sub">POCKET SYNTH / SAMPLER</div>
      <div class="cassio-preload-bar">
        <span class="cassio-preload-block"></span>
        <span class="cassio-preload-block"></span>
        <span class="cassio-preload-block"></span>
        <span class="cassio-preload-block"></span>
        <span class="cassio-preload-block"></span>
        <span class="cassio-preload-block"></span>
        <span class="cassio-preload-block"></span>
        <span class="cassio-preload-block"></span>
        <span class="cassio-preload-block"></span>
        <span class="cassio-preload-block"></span>
        <span class="cassio-preload-block"></span>
        <span class="cassio-preload-block"></span>
      </div>
      <div class="cassio-preload-msg">POWER ON</div>
    </div>
    <%= yield %>
  </body>
</html>
