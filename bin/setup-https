#!/usr/bin/env bash
# Generate/refresh mkcert certs for localhost + current LAN IP.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CERT_DIR="$ROOT/config/certs"
mkdir -p "$CERT_DIR"

if ! command -v mkcert >/dev/null 2>&1; then
  echo "mkcert not found. Install with: sudo apt-get install -y mkcert libnss3-tools"
  exit 1
fi

# Local CA (may need sudo once for desktop trust; phone still needs manual install)
mkcert -install 2>/dev/null || {
  echo "Note: mkcert CA not in system trust store (sudo may be required)."
  echo "Phone: install $(mkcert -CAROOT)/rootCA.pem as a trusted CA."
}

IP="$(hostname -I 2>/dev/null | awk '{print $1}')"
NAMES=(localhost 127.0.0.1 ::1)
if [[ -n "${IP:-}" ]]; then
  NAMES+=("$IP")
fi

cd "$CERT_DIR"
mkcert -cert-file localhost+lan.pem -key-file localhost+lan-key.pem "${NAMES[@]}"

# Public CA cert for phone download (not the private key)
CA_ROOT="$(mkcert -CAROOT)"
cp "$CA_ROOT/rootCA.pem" "$ROOT/public/dev-ca.pem"

echo
echo "Certs ready in config/certs/"
echo "  names: ${NAMES[*]}"
echo "Phone CA: $ROOT/public/dev-ca.pem  (also at $CA_ROOT/rootCA.pem)"
echo
echo "Next: bin/dev-https"
echo "Then on phone: open https://${IP:-localhost}:3000/dev-ca.pem , install CA, enable trust,"
echo "then open https://${IP:-localhost}:3000/"
